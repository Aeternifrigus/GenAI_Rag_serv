# Every value here is optional. With none of them set the service runs fully
# offline using an in-memory index, LSA embeddings and extractive answers.

# Vector store. Unset -> in-memory.
# DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Mongo source. Unset -> the mongo connector is not registered at all.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=genai
# MONGO_COLLECTION=documents

# Generation. Unset -> extractive answers, no model call, no cost.
# ANTHROPIC_API_KEY=sk-ant-...

# Embeddings: auto | sentence-transformers | lsa
EMBED_PROVIDER=auto
EMBED_DIM=256

# Retrieval
TOP_K=5
MIN_SCORE=0.05
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Pull from configured sources on startup
AUTO_INGEST=true
PORT=8080
